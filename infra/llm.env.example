# Copy to /etc/another-you.env (0600, root-owned). Never put keys in dist or src.
LLM_ENABLED=false
GLM_API_KEY=
GLM_MODEL=glm-5.3
GLM_ENDPOINT=https://api.z.ai/api/paas/v4/chat/completions
# 0 disables the application daily generation quota.
LLM_DAILY_LIMIT=0
# Comma-separated exact trusted test egress IPs; do not trust X-Forwarded-For.
IP_WHITELIST=
